# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional Database: MongoDB Connection URI (Leave blank for in-memory persistence)
MONGODB_URI=

# Optional AI API Key (Gemini API for enhanced intent parsing fallback)
GEMINI_API_KEY=

# Frontend Configuration (in frontend/.env)
VITE_API_URL=http://localhost:5000/api
